{
  "datasets": [
    {
      "name": "kpis",
      "displayName": "KPIs",
      "queryLines": [
        "SELECT COUNT(DISTINCT id_compra) AS compras, COUNT(*) AS itens, SUM(valor_total_item) AS valor_total\n",
        "FROM gold.fato_compras\n",
        "WHERE NOT compra_excluida\n"
      ]
    },
    {
      "name": "orgaos",
      "displayName": "Gasto por órgão",
      "queryLines": [
        "SELECT o.nome_orgao_superior AS orgao, SUM(f.valor_total_item) AS valor_total\n",
        "FROM gold.fato_compras f\n",
        "JOIN gold.dim_orgao o ON o.sk_orgao = f.sk_orgao\n",
        "WHERE NOT f.compra_excluida\n",
        "GROUP BY 1\n",
        "ORDER BY 2 DESC\n",
        "LIMIT 15\n"
      ]
    },
    {
      "name": "mensal",
      "displayName": "Evolução mensal",
      "queryLines": [
        "SELECT to_date(concat(cast(d.ano_mes AS string), '01'), 'yyyyMMdd') AS mes,\n",
        "       m.regime_legal,\n",
        "       SUM(f.valor_total_item) AS valor_total\n",
        "FROM gold.fato_compras f\n",
        "JOIN gold.dim_data d ON d.sk_data = f.sk_data_publicacao\n",
        "JOIN gold.dim_modalidade m ON m.sk_modalidade = f.sk_modalidade\n",
        "WHERE NOT f.compra_excluida\n",
        "GROUP BY ALL\n"
      ]
    },
    {
      "name": "modalidades",
      "displayName": "Modalidades",
      "queryLines": [
        "SELECT m.grupo, m.regime_legal, SUM(f.valor_total_item) AS valor_total\n",
        "FROM gold.fato_compras f\n",
        "JOIN gold.dim_modalidade m ON m.sk_modalidade = f.sk_modalidade\n",
        "WHERE NOT f.compra_excluida\n",
        "GROUP BY ALL\n"
      ]
    },
    {
      "name": "fornecedores",
      "displayName": "Top fornecedores (contratos)",
      "queryLines": [
        "SELECT df.ni_fornecedor, MAX(df.razao_social) AS razao_social, MAX(df.porte_nome) AS porte,\n",
        "       COUNT(*) AS contratos, SUM(f.valor_global) AS valor_global\n",
        "FROM gold.fato_contratos f\n",
        "JOIN gold.dim_fornecedor df ON df.sk_fornecedor = f.sk_fornecedor\n",
        "WHERE NOT f.excluido AND f.sk_fornecedor <> -1\n",
        "GROUP BY df.ni_fornecedor\n",
        "ORDER BY valor_global DESC\n",
        "LIMIT 25\n"
      ]
    },
    {
      "name": "dq",
      "displayName": "Resultados de qualidade",
      "queryLines": [
        "SELECT data_execucao, run_id, regra, dimensao, severidade, entidade, janela, camada,\n",
        "       linhas_avaliadas, linhas_reprovadas, status, detalhe\n",
        "FROM quality.dq_resultados\n",
        "WHERE data_execucao >= current_timestamp() - INTERVAL 30 DAYS\n"
      ]
    },
    {
      "name": "quarentena",
      "displayName": "Quarentena por regra",
      "queryLines": [
        "SELECT entidade, regra, COUNT(*) AS registros\n",
        "FROM (\n",
        "  SELECT 'licitacoes' AS entidade, explode(regra_violada) AS regra\n",
        "  FROM quality.quarentena_licitacoes WHERE NOT resolvido\n",
        "  UNION ALL SELECT 'itens_compra', explode(regra_violada)\n",
        "  FROM quality.quarentena_itens_compra WHERE NOT resolvido\n",
        "  UNION ALL SELECT 'contratos', explode(regra_violada)\n",
        "  FROM quality.quarentena_contratos WHERE NOT resolvido\n",
        "  UNION ALL SELECT 'fornecedores', explode(regra_violada)\n",
        "  FROM quality.quarentena_fornecedores WHERE NOT resolvido\n",
        ")\n",
        "GROUP BY ALL\n"
      ]
    },
    {
      "name": "ingestao",
      "displayName": "Ingestão",
      "queryLines": [
        "SELECT entidade,\n",
        "       MAX(fim) FILTER (WHERE status = 'sucesso') AS ultima_carga_ok,\n",
        "       SUM(linhas) FILTER (WHERE fim >= current_timestamp() - INTERVAL 1 DAY) AS linhas_24h,\n",
        "       COUNT_IF(status = 'falha' AND fim >= current_timestamp() - INTERVAL 7 DAYS) AS falhas_7d\n",
        "FROM ctl.ctl_ingestao_log\n",
        "GROUP BY entidade\n"
      ]
    }
  ],
